# terraform.tfvars — valores padrão para o ambiente de desenvolvimento
# NÃO commitar valores sensíveis aqui (chaves, tokens, passwords)

aws_region         = "us-east-1"
environment        = "dev"
project_name       = "technova"
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
instance_type      = "t2.micro"
app_port           = 3000
