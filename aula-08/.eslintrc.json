{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "commonjs"
  },
  "rules": {
    "semi": ["error", "always"],
    "quotes": ["error", "single"],
    "no-unused-vars": ["error", { "vars": "all", "args": "after-used" }],
    "no-console": "warn",
    "eqeqeq": ["error", "always"],
    "indent": ["error", 2],
    "no-var": "error",
    "prefer-const": "error"
  }
}
